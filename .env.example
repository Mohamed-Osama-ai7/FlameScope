# FlameScope - copy to .env (git-ignored) and fill in. Never commit real keys.

# ---- Scientific Intelligence Layer (docs/14_rag_copilot.md) ----
# Default retrieval is BM25 (mode=bm25). Dense backend: none | hashing (offline stand-in, NOT neural) | bge-m3 (needs: pip install ".[rag]")
FLAMESCOPE_DENSE_BACKEND=none
FLAMESCOPE_DENSE_MODEL=BAAI/bge-m3
# Optional cross-encoder reranker: none | bge  (BAAI/bge-reranker-v2-m3; needs ".[rag]" and the weights)
FLAMESCOPE_RERANK_BACKEND=none
FLAMESCOPE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
FLAMESCOPE_DEVICE=cpu
# Where embedding caches are written (git-ignored). Default: data/processed/rag
# FLAMESCOPE_RAG_CACHE=
# Hybrid fusion: rrf | weighted
FLAMESCOPE_HYBRID_FUSION=rrf
FLAMESCOPE_RRF_K=60
FLAMESCOPE_BM25_WEIGHT=0.5
FLAMESCOPE_DENSE_WEIGHT=0.5

# LLM provider: extractive (offline, deterministic, default) | openai_compat
FLAMESCOPE_LLM_PROVIDER=extractive
# openai_compat: any OpenAI-compatible /chat/completions endpoint (OpenAI, vLLM, Ollama, gateways)
FLAMESCOPE_LLM_BASE_URL=https://api.openai.com/v1
FLAMESCOPE_LLM_MODEL=
FLAMESCOPE_LLM_API_KEY=
FLAMESCOPE_LLM_TIMEOUT_S=60

# Audit routes /api/v1/rag/admin/* (excluded chunks and exclusion reasons). Disabled when empty.
# Send the value in the X-FlameScope-Admin-Token header. Never reuse a real credential here.
FLAMESCOPE_RAG_ADMIN_TOKEN=

# Scientific Data Platform database (branch feat/scientific-data-platform). When set and the platform
# package is present, every measurement the Copilot cites is checked against it (docs/15 B.5).
# FLAMESCOPE_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/flamescope
