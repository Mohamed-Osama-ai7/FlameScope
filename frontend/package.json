{
  "name": "flamescope-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p .",
    "check:bundle": "node scripts/check-bundle.mjs dist",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "bench": "playwright test -c playwright.bench.config.ts"
  },
  "dependencies": {
    "@tanstack/react-table": "8.20.6",
    "plotly.js": "npm:plotly.js-cartesian-dist-min@2.35.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-plotly.js": "2.6.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/plotly.js": "3.0.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-plotly.js": "2.6.3",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "3.0.5"
  }
}
